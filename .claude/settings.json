{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(./cv-private/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(type .env*)",
      "PowerShell(Get-Content .env*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(winget install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npx:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "PowerShell(git push:*)",
      "WebFetch"
    ]
  }
}
